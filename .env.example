# --- PostgreSQL Configuration ---
POSTGRES_DB=hrcvhelper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/hrcvhelper

# --- S3 / MinIO Configuration ---
S3_ENDPOINT_URL=http://s3:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=cv-resumes
S3_REGION_NAME=us-east-1

# --- Security & JWT ---
SECRET_KEY=hrcvhelper-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Ollama / LLM Configuration ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:latest

# --- Microservices URLs (for Gateway) ---
AUTH_SYSTEM_URL=http://auth_system:8001
MD_CONVERTOR_URL=http://md_convertor:8002
LLM_CONVERTOR_URL=http://llm_convertor:8003
JSON_TO_WORD_URL=http://json_to_word:8004
DB_CONNECTOR_URL=http://db_connector:8005
